# LLM só pelo AI Proxy da Avenue (docs/infra-ia/README.md).
# Antes de subir: `gh auth setup-git` (uma vez por máquina) e `uv sync --extra avenue`.
# Rodando local, exige VPN ou rede corporativa.
LLM_PROVIDER=avenue

# Chave do app no Dev Portal (https://devportal-ai.avenuesec.io/).
AI_PROXY_API_KEY=

# Modelo aprovado para o app no Dev Portal: id (gemini-4-neon) ou nome do enum (GEMINI_4_NEON).
LLM_MODEL=gemini-4-neon

# Reserva tentada quando o principal responde 429/5xx; também precisa estar aprovada no app.
LLM_FALLBACK_MODELS='["gemini-3.5-flash"]'

# Opcional: time para atribuir custo (header x-avenue-team).
# AI_PROXY_TEAM=

# Opcional: o SDK loga cada requisição no stderr por padrão.
# AI_PROXY_DEBUG=false

# CORS fica fechado por padrão (o app nativo não precisa). Para um front web local:
# CORS_ORIGINS='["http://localhost:5173"]'

# Banco: SQLite em arquivo, criado e populado na subida. Para zerar, apague backend/data/.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
