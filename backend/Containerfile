# Backend FastAPI + ADK em container, construído com Podman. Uso normal pela raiz do repo:
#   podman compose up --build
# Rodar sem container continua valendo: cd backend && uv run fastapi dev app/main.py
#
# Imagens com nome completo (registro incluído): o Podman pode recusar nome curto
# quando short-name-mode=enforcing e não há terminal para perguntar o registro.

FROM docker.io/library/python:3.14-slim-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
WORKDIR /app

# Dependências primeiro, para o cache da camada sobreviver a mudanças de código.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev

# Cópia explícita: .env, .venv, data/ e tests/ nunca entram na imagem,
# mesmo que o provider de compose não aplique o .containerignore.
COPY pyproject.toml uv.lock /app/
COPY app /app/app
COPY mcp_servers /app/mcp_servers
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

# O backend lê o catálogo A2UI de <raiz do repo>/contracts/catalog.json, que fica fora
# do contexto do build (./backend). Na imagem, a "raiz" é /, então o caminho vira
# /contracts/catalog.json. Geramos com o mesmo comando do repo; o teste
# test_catalog_json_is_up_to_date garante que o arquivo versionado é igual a este.
RUN /app/.venv/bin/python -m app.export_catalog

FROM docker.io/library/python:3.14-slim-trixie
RUN useradd --create-home --uid 1000 app
WORKDIR /app
COPY --from=builder --chown=app:app /app /app
COPY --from=builder /contracts /contracts
# SQLite fica em /app/data (montado como volume pelo compose).
RUN mkdir -p /app/data && chown app:app /app/data
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
USER app
EXPOSE 8000
CMD ["fastapi", "run", "app/main.py", "--host", "0.0.0.0", "--port", "8000"]
